# Where this app's persistent data lives. Blank = ./data next to this
# app. Set to an absolute path to store it elsewhere, e.g. an external
# drive: DATA_DIR=/mnt/external/catasophie/llm-assistant (the drive must
# already be mounted - install.sh won't create the mount point itself,
# only the app subfolder under it).
DATA_DIR=

# Port published on the host - reachable at http://localhost:<port>/
# (or http://<device-ip>:<port>/ from another device on the LAN).
LLM_ASSISTANT_PORT=3050

# Which Ollama model to pull/run (see install.sh, which pulls it inside
# the ollama container on first install and whenever you change this).
# CPU inference only - no GPU passthrough is configured, so pick a size
# that's tolerable on your hardware. Browse valid tags at
# https://ollama.com/library. Rough guide (RAM needed roughly = model
# size on disk):
#   llama3.2:3b (default) - ~2G, fastest, usable on a Raspberry Pi
#   phi3:mini              - ~2.3G, small, good for its size
#   mistral:7b              - ~4G, noticeably slower on CPU-only, better quality
#   qwen2.5:7b               - ~4.7G, similar tradeoff to mistral:7b
LLM_ASSISTANT_MODEL=llama3.2:3b

# Whether the chat UI requires a login. Off by default (false) since
# this is meant for a single trusted LAN/household - set to true if
# this device is reachable more broadly (see docs/ARCHITECTURE.md).
LLM_ASSISTANT_AUTH=false

# Embedding model used for document/knowledge-base RAG features (routed
# through ollama, not downloaded from huggingface.co - see
# docker-compose.yml). Only matters if you use those features; pull it
# first with:
#   podman-compose -f apps/llm-assistant/docker-compose.yml exec ollama ollama pull nomic-embed-text
LLM_ASSISTANT_EMBEDDING_MODEL=nomic-embed-text
