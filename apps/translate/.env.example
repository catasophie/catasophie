# Where this app's persistent data (downloaded language models) lives.
# Blank = ./data next to this app. Set to an absolute path to store it
# elsewhere, e.g. an external drive:
# DATA_DIR=/mnt/external/catasophie/translate (the drive must already
# be mounted - install.sh won't create the mount point itself, only the
# app subfolder under it).
DATA_DIR=

# Port published on the host - reachable at http://localhost:<port>/
# (or http://<device-ip>:<port>/ from another device on the LAN).
TRANSLATE_PORT=3030

# Comma-separated list of ISO language codes to load/install, e.g.
# en,es,fr,de - LibreTranslate installs every translation pair among
# this set (roughly 150-200MB per language, more for larger languages).
# Managed by scripts/select-languages.sh (also called by install.sh) -
# don't hand-edit this while the app is running; re-run that script to
# add/remove languages instead, so the new models actually get
# downloaded. See https://libretranslate.com/languages for valid codes.
TRANSLATE_LANGS=en,es
