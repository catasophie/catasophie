# Where this app's persistent data lives. Blank = ./data next to this
# app. Set to an absolute path to store it elsewhere, e.g. an external
# drive: DATA_DIR=/mnt/external/catasophie/wikimed (the drive must
# already be mounted - install.sh won't create the mount point itself,
# only the app subfolder under it).
DATA_DIR=

# Port published on the host - reachable at http://localhost:<port>/
# (or http://<device-ip>:<port>/ from another device on the LAN).
WIKIMED_PORT=3020

# Space-separated list of ZIM content to download (see
# scripts/download-zim.sh and README.md for details). Blank =
# install.sh prompts for this, defaulting to zimgit-medicine. Available
# catalog keys (all from https://download.kiwix.org/zim/other/):
#   zimgit-medicine (default)  - offline survival medicine guide, ~70M
#   zimgit-post-disaster       - broader post-disaster survival guide, ~600M
#   zimgit-water               - water safety/purification, ~20M
#   zimgit-food-preparation    - food safety/preparation, ~90M
#   zimgit-knots               - practical knots reference, ~30M
#   wikem                      - WikEM emergency medicine wiki, ~360M
#   mdwiki                     - full "WikiMed" medical encyclopedia, ~2G
# You can also add one-off content via a custom:<url> entry, e.g.:
#   WIKIMED_ZIMS=zimgit-medicine custom:https://example.com/some.zim
WIKIMED_ZIMS=
