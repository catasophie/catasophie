# Any Ollama-compatible tag. Smaller model for Pi/constrained hardware
# (phi3:mini, llama3.2:3b), bigger on laptop/mini-PC (llama3.1:8b, gemma2:9b).
OLLAMA_MODEL=llama3.2:3b

# Generated manually in Open WebUI (Settings -> Account -> API Keys) after
# the first account is created. install.sh will prompt for this and
# offer to run corpus ingestion once it's set.
OPEN_WEBUI_API_KEY=
