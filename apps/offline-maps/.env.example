# Which service to download the region extract from. Blank = install.sh
# prompts for this (radiolist if whiptail/dialog is available, else a
# numbered prompt, defaulting to geofabrik). Options:
#   geofabrik (default) - https://download.geofabrik.de/ - MAP_REGION is
#     a hierarchical region path, e.g. europe/germany
#   osmfr               - https://download.openstreetmap.fr/extracts/
#     mirror, same MAP_REGION format as geofabrik
#   bbbike              - https://download.bbbike.org/osm/bbbike/ -
#     MAP_REGION is just a city name, e.g. Berlin
#   custom              - provide the full URL yourself via
#     MAP_SOURCE_URL below; MAP_REGION only labels the output files
MAP_SOURCE=

# Region path (geofabrik/osmfr, e.g. "europe/germany" or
# "north-america/us/california") or BBBike city name (e.g. "Berlin"),
# depending on MAP_SOURCE above. See https://download.geofabrik.de/,
# https://download.openstreetmap.fr/extracts/, or
# https://download.bbbike.org/osm/bbbike/ for valid values.
MAP_REGION=

# Only used when MAP_SOURCE=custom (or to force an override regardless
# of MAP_SOURCE): full .osm.pbf download URL.
MAP_SOURCE_URL=

# Where tiles data lives. Blank = ./data next to this app.
# Set to an absolute path to store it elsewhere, e.g. an external drive:
# DATA_DIR=/mnt/external/catasophie/offline-maps (the drive must already
# be mounted - install.sh won't create the mount point itself, only the
# app subfolder under it).
DATA_DIR=

# Ports published on the host - reachable at http://localhost:<port>/
# (or http://<device-ip>:<port>/ from another device on the LAN). The
# web frontend calls tiles directly by port (see
# templates/config.js.template), so this must stay in sync with
# whatever the frontend is told - install.sh keeps them consistent.
MAPS_WEB_PORT=3010
MAPS_TILES_PORT=3012
