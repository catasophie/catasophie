# Port the dashboard listens on - reachable at http://localhost:<port>/
# (or http://<device-ip>:<port>/ from another device on the LAN).
DASHBOARD_PORT=8000

# Interface to bind to. 0.0.0.0 (default) makes it reachable from other
# devices on the LAN, not just this host.
DASHBOARD_HOST=0.0.0.0

# Host advertised to the browser as part of every app's URL (so links
# work from other devices on the LAN, not just this one - "localhost"
# would only ever resolve back to whichever device is viewing the page).
# Blank (default) = auto-detect this device's LAN IP at scan time
# (dashboard startup, or the "Rescan" button). Set this explicitly if
# auto-detection picks the wrong interface - e.g. this device has both
# Ethernet and its own WiFi hotspot active - or to use a stable
# hostname instead of an IP.
DASHBOARD_ADVERTISE_HOST=

# Shown in the header. Location is blank/hidden by default.
DASHBOARD_SYSTEM_NAME=Resilience Hub
DASHBOARD_LOCATION=

# How often (in seconds) the browser re-polls /api/status for
# running/stopped state. This does NOT re-scan apps/*/manifest.json -
# that only happens at dashboard startup or via the "Rescan" button
# (POST /api/rescan) - see apps/dashboard/README.md.
DASHBOARD_STATUS_POLL_INTERVAL_SECONDS=15

