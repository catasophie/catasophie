# Where this app's persistent data lives (SDR device/profile config,
# users database, bookmarks). Blank = ./data next to this app. Set to
# an absolute path to store it elsewhere, e.g. an external drive:
# DATA_DIR=/mnt/external/catasophie/sdr (the drive must already be
# mounted - install.sh won't create the mount point itself, only the
# app subfolder under it).
DATA_DIR=

# Port published on the host - reachable at http://localhost:<port>/
# (or http://<device-ip>:<port>/ from another device on the LAN).
SDR_PORT=3040

# Timezone inside the container (affects logged timestamps).
TZ=UTC

# Admin account auto-created on first boot - lets you skip the manual
# first-run signup wizard. You'll still need to log in once at
# http://localhost:<port>/settings to add your RTL-SDR device and at
# least one frequency profile (OpenWebRX has no supported way to
# pre-configure that non-interactively - see README.md).
OPENWEBRX_ADMIN_USER=admin
OPENWEBRX_ADMIN_PASSWORD=
