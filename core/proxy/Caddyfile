# Single entrypoint reverse proxy.
# All auth enforcement + dynamic tool routing happens in the dashboard app,
# since the set of tools changes at runtime (new tools dropped into tools/).
# Caddy just forward-auths and forwards everything to the dashboard.
#
# HTTPS with a self-signed, locally-generated cert ("tls internal") is used
# even on a fully offline LAN, because Authelia's session cookies require a
# secure (https/wss) context to work correctly in real browsers. This does
# NOT require internet access - Caddy generates and manages its own local
# CA entirely offline. Clients will see a certificate warning the first
# time they connect (expected for a self-hosted local device, similar to a
# router's admin UI) unless they import Caddy's local root CA.
#
# Authelia is served on its own subdomain (auth.<hostname>) rather than a
# subpath, because Authelia's own static assets/links assume it's served at
# the root of its domain. This works out of the box with the WiFi AP's
# dnsmasq wildcard DNS (every hostname resolves to the device), and with a
# real router/DNS setup a wildcard "*.catasophie.local" CNAME achieves the
# same thing.

{
	admin off
}

:80 {
	redir https://{host}{uri} permanent
}

auth.{$CATASOPHIE_HOSTNAME} {
	tls internal
	reverse_proxy auth:9091
}

{$CATASOPHIE_HOSTNAME}, localhost {
	tls internal

	forward_auth auth:9091 {
		uri /api/verify?rd=https://auth.{$CATASOPHIE_HOSTNAME}/
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
	reverse_proxy dashboard:8000
}
