# === Internal (auto-set by install.sh, do not edit by hand) ===
# Absolute host path to this repo. Required because the dashboard drives
# `podman-compose` against the HOST podman API (via the mounted socket),
# so any bind-mount paths it constructs must be real host paths, not paths
# inside the dashboard container.
CATASOPHIE_ROOT=
# Path to the host's Podman API socket (reported by `podman info`), mounted
# into the dashboard container so it can manage tool containers.
PODMAN_SOCK=

# === Identity / Networking ===
CATASOPHIE_HOSTNAME=catasophie.local
DASHBOARD_PORT=443
DASHBOARD_HTTP_PORT=80

# WiFi Access Point (used by scripts/setup-wifi-ap.sh)
WIFI_AP_ENABLED=false
WIFI_AP_INTERFACE=wlan0
WIFI_AP_SSID=catasophie
WIFI_AP_PASSWORD=changeme123
WIFI_AP_COUNTRY_CODE=US

# === Auth (Authelia) ===
AUTH_SESSION_SECRET=changeme-generate-a-random-secret
AUTH_STORAGE_ENCRYPTION_KEY=changeme-generate-a-random-key
AUTH_JWT_SECRET=changeme-generate-a-random-secret

# === Hardware profile ===
# one of: pi | mini-pc | laptop  (auto-detected by the first-boot wizard, override here)
HARDWARE_PROFILE=auto

# === Power monitor ===
# one of: auto | laptop | pi-i2c | nut | none
POWER_BACKEND=auto
# only used when POWER_BACKEND=nut
NUT_UPS_NAME=
NUT_HOST=localhost
NUT_PORT=3493

# === Regions (used by tools/maps once enabled) ===
MAP_REGION=

# === Setup state ===
SETUP_COMPLETE=false
