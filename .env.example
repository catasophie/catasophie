# Path to the podman API socket, mounted into the proxy container so
# Traefik can watch containers and auto-configure routers from their
# labels. Auto-detected and written here by scripts/up.sh if left blank -
# you normally don't need to set this by hand. Rootless podman typically
# uses /run/user/<uid>/podman/podman.sock (NOT /run/podman/podman.sock,
# which is the rootful socket and not readable by a normal user).
PODMAN_SOCK=

# Hostname used for LAN access (add to /etc/hosts or use mDNS if your router
# doesn't do it automatically)
CATASOPHIE_HOSTNAME=catasophie.local

# Ports the reverse proxy listens on.
# Rootless podman can't bind ports < 1024 by default, so 80 will fail with
# "cannot expose privileged port" unless you either:
#   a) run `sudo sysctl net.ipv4.ip_unprivileged_port_start=80` (persist in
#      /etc/sysctl.conf), or
#   b) leave this at 8080 and access via http://catasophie.local:8080/
PROXY_HTTP_PORT=8080
# Traefik dashboard (bind to localhost only in production, see proxy/traefik.yml)
PROXY_DASHBOARD_PORT=8081

# === apps/llm-survival ===
# Any Ollama-compatible tag. Pick a small model for Pi/constrained hardware
# (e.g. phi3:mini, llama3.2:3b), a bigger one on laptop/mini-PC (llama3.1:8b).
OLLAMA_MODEL=llama3.2:3b

# === apps/offline-maps ===
# Where to download the region extract from: geofabrik (default), osmfr,
# bbbike, or custom. See apps/offline-maps/.env.example for details.
MAP_SOURCE=
# Region path (geofabrik/osmfr, e.g. "europe/germany") or BBBike city
# name (e.g. "Berlin"), depending on MAP_SOURCE above.
MAP_REGION=
# Only used when MAP_SOURCE=custom (or to force an override): full
# .osm.pbf URL.
MAP_SOURCE_URL=
