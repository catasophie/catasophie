# Hostname used for LAN access (add to /etc/hosts or use mDNS if your router
# doesn't do it automatically)
CATASOPHIE_HOSTNAME=catasophie.local

# Ports the reverse proxy listens on
PROXY_HTTP_PORT=80
# Traefik dashboard (bind to localhost only in production, see proxy/traefik.yml)
PROXY_DASHBOARD_PORT=8080

# === apps/llm-survival ===
# Any Ollama-compatible tag. Pick a small model for Pi/constrained hardware
# (e.g. phi3:mini, llama3.2:3b), a bigger one on laptop/mini-PC (llama3.1:8b).
OLLAMA_MODEL=llama3.2:3b

# === apps/offline-maps ===
# Geofabrik region path, e.g. "europe/germany" or "north-america/us/california"
# See https://download.geofabrik.de/ for the full list of region identifiers.
MAP_REGION=
